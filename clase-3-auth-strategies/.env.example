PORT=8080

# Firma de JWT — en producción debe ser una clave fuerte y secreta
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=1h

# Conexión a MongoDB (Atlas o local)
# Ejemplo local:   mongodb://localhost:27017/authdb
# Ejemplo Atlas:   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/authdb?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/authdb
