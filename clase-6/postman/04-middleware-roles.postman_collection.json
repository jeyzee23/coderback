{
  "info": {
    "name": "Semana 6 - 04 Middleware Roles",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3604"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Ruta publica",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/resources/public",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resources",
            "public"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login usuario y guardar token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Ruta privada usuario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/resources/private",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resources",
            "private"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin con usuario debe dar 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/resources/admin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resources",
            "admin"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Login admin y guardar adminToken",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@test.com\",\n  \"password\": \"123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin con adminToken",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/resources/admin",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "resources",
            "admin"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status OK', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));"
            ]
          }
        }
      ]
    }
  ]
}