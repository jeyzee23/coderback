# Puerto del servidor
PORT=3000

# Secreto para firmar la cookie de sesión (cambiar en producción)
SESSION_SECRET=mi_secreto_super_seguro

# Entorno: development | production
NODE_ENV=development

# Tipo de almacenamiento de sesiones: memory | file | mongo
SESSION_STORE=memory

# URI de MongoDB (solo necesario si SESSION_STORE=mongo)
# Puede ser local: mongodb://localhost:27017/clase-sesiones
# O de Atlas: mongodb+srv://usuario:password@cluster.mongodb.net/sessionsdb
MONGODB_URI=mongodb+srv://usuario:password@tu-cluster.mongodb.net/sessionsdb?retryWrites=true&w=majority
